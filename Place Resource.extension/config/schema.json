{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://place-resource.local/schemas/view-legend-creator/legends-1.0.json",
  "title": "View-Based Legend Creator settings",
  "type": "object",
  "required": ["schema_version", "parameter_alias_file", "legend_definitions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "parameter_alias_file": {"type": "string", "minLength": 1},
    "legend_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/legendDefinition"}
    }
  },
  "definitions": {
    "legendDefinition": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "category",
        "source_view_types",
        "template_legend_name",
        "output_name_pattern",
        "output_identity_parameter",
        "include",
        "sort",
        "representation",
        "layout",
        "labels",
        "styles",
        "update"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "pattern": "^OST_"},
        "source_view_types": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "template_legend_name": {"type": "string", "minLength": 1},
        "output_name_pattern": {"type": "string", "minLength": 1},
        "output_identity_parameter": {"type": "string", "minLength": 1},
        "include": {
          "type": "object",
          "required": [
            "basic_walls",
            "curtain_walls",
            "stacked_walls",
            "in_place_walls",
            "linked_models"
          ],
          "properties": {
            "basic_walls": {"type": "boolean"},
            "curtain_walls": {"type": "boolean"},
            "stacked_walls": {"type": "boolean"},
            "in_place_walls": {"type": "boolean"},
            "linked_models": {"type": "boolean"},
            "demolished": {"type": "boolean"},
            "stacked_wall_members": {"type": "boolean"},
            "when_parts_replace_original": {"type": "boolean"}
          }
        },
        "sort": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["parameter", "direction", "natural_sort"],
            "properties": {
              "parameter": {"type": "string"},
              "direction": {"enum": ["ascending", "descending"]},
              "natural_sort": {"type": "boolean"}
            }
          }
        },
        "representation": {
          "type": "object",
          "required": ["view_direction", "host_length_mm", "detail_level", "scale"],
          "properties": {
            "view_direction": {
              "enum": ["Section", "FloorPlan", "ElevationFront", "ElevationBack", "ElevationLeft", "ElevationRight"]
            },
            "host_length_mm": {"type": "number", "exclusiveMinimum": 0},
            "detail_level": {"enum": ["Coarse", "Medium", "Fine"]},
            "scale": {"type": "integer", "minimum": 1},
            "layer_reference_planes": {"type": "boolean"},
            "fallback_detail_lines": {"type": "boolean"}
          }
        },
        "layout": {
          "type": "object",
          "required": [
            "direction",
            "columns",
            "origin_x_mm",
            "origin_y_mm",
            "row_height_mm",
            "column_gap_mm",
            "graphic_width_mm",
            "label_gap_mm",
            "heading_gap_mm",
            "align",
            "auto_size_rows"
          ],
          "properties": {
            "direction": {"enum": ["vertical", "horizontal"]},
            "columns": {"type": "integer", "minimum": 1},
            "origin_x_mm": {"type": "number"},
            "origin_y_mm": {"type": "number"},
            "row_height_mm": {"type": "number"},
            "column_gap_mm": {"type": "number"},
            "graphic_width_mm": {"type": "number"},
            "label_gap_mm": {"type": "number"},
            "heading_gap_mm": {"type": "number"},
            "align": {"enum": ["top_left", "top_right", "bottom_left", "bottom_right"]},
            "auto_size_rows": {"type": "boolean"}
          }
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["parameter", "heading", "width_mm", "required"],
            "properties": {
              "parameter": {"type": "string"},
              "heading": {"type": "string"},
              "width_mm": {"type": "number", "exclusiveMinimum": 0},
              "required": {"type": "boolean"},
              "format": {"enum": ["millimetres", "text"]},
              "decimals": {"type": "integer", "minimum": 0},
              "default": {}
            }
          }
        },
        "styles": {
          "type": "object",
          "required": ["text_note_type", "header_text_note_type", "line_style", "show_border", "show_headers"],
          "properties": {
            "text_note_type": {"type": "string"},
            "header_text_note_type": {"type": "string"},
            "line_style": {"type": "string"},
            "show_border": {"type": "boolean"},
            "show_headers": {"type": "boolean"}
          }
        },
        "update": {
          "type": "object",
          "required": [
            "remove_unused_entries",
            "preserve_manual_notes",
            "preserve_viewport_position",
            "confirm_before_deleting"
          ],
          "properties": {
            "remove_unused_entries": {"type": "boolean"},
            "preserve_manual_notes": {"type": "boolean"},
            "preserve_viewport_position": {"type": "boolean"},
            "confirm_before_deleting": {"type": "boolean"},
            "full_rebuild": {"type": "boolean"},
            "create_when_empty": {"type": "boolean"},
            "sync_legend_name": {"type": "boolean"},
            "reset_representation": {"type": "boolean"}
          }
        },
        "type_rules": {"type": "object"},
        "sheet_placement": {
          "type": "object",
          "properties": {
            "mode": {"enum": ["pick_point", "configured_point"]},
            "anchor_x_mm": {"type": "number"},
            "anchor_y_mm": {"type": "number"},
            "prevent_duplicate_on_same_sheet": {"type": "boolean"}
          }
        }
      }
    }
  }
}
