{
  "schema_version": "2.0",
  "defaults": {
    "family_name": "PR Legend - {category}",
    "description_parameter": "Legend_Description",
    "type_mark_visibility_parameter": "Legend_TypeMark_Visibility",
    "text_visibility_parameter": "Text_Visibility",
    "show_type_mark": true,
    "template_legend_name": "_TEMPLATE - LIBRARY LEGEND",
    "output_name_pattern": "{category} LEGEND",
    "sheet_output_name_pattern": "{category} LEGEND - {sheet_number}",
    "scale": 100,
    "source_view_types": ["FloorPlan", "CeilingPlan", "Section", "Elevation"],
    "styles": {
      "heading_text_type": "2.5mm Arial Bold",
      "show_heading": true,
      "text_type": "2.5mm Arial",
      "show_text": true
    },
    "layout": {
      "row_gap_mm": 3,
      "heading_gap_mm": 5,
      "text_gap_mm": 3,
      "width_mm": 120,
      "text_pattern": "{description}"
    },
    "sheet_placement": {
      "mode": "pick_point",
      "anchor_x_mm": 20,
      "anchor_y_mm": 20,
      "prevent_duplicate_on_same_sheet": true
    }
  },
  "categories": [
    {"name": "Fire Strategy", "revit_category": null},
    {"name": "Accessibility", "revit_category": null},
    {"name": "Thermal Envelope", "revit_category": null},
    {"name": "Acoustic", "revit_category": null},
    {"name": "Bollards and Barrier Protection", "revit_category": null},
    {"name": "Access and Maintenance", "revit_category": null},
    {"name": "Room Use", "revit_category": null},
    {"name": "Security Zone", "revit_category": null},
    {"name": "Walls", "revit_category": "OST_Walls"},
    {"name": "Floors", "revit_category": "OST_Floors"},
    {"name": "Ceilings", "revit_category": "OST_Ceilings"},
    {"name": "Doors", "revit_category": "OST_Doors"}
  ]
}
